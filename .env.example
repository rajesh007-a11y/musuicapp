# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==============================================================================
# JIOSAAVN API CONFIGURATION
# ==============================================================================
# Paste your JioSaavn API key / Bearer Token below if your provider requires authentication.
# (If using a public open-source saavn.dev instance, leave empty or default)
JIOSAAVN_API_KEY=YOUR_JIOSAAVN_API_KEY

# Optional Base URL for your JioSaavn API instance (Default: https://musicapp-nu.vercel.app/)
JIOSAAVN_BASE_URL=https://musicapp-nu.vercel.app/
